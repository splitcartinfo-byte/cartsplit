# Admin Password (.env controlled)
VITE_ADMIN_PASSWORD=adminPass123!

# Firebase Client Configuration (Vite Standard)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Razorpay Configuration (Public Key ID for checkout UI)
VITE_RAZORPAY_KEY_ID=

# Razorpay Private Secrets (Server-Only, never in browser)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Mode: 'test' or 'live'
PAYMENT_MODE=test

